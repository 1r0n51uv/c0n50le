<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The tvOS look, from Apple's tvOS UI kit (Figma, 1920×1080). ThemeManager recolours these brushes in place for
         Light/Dark and the Liquid Glass depth, so every control follows at once. Values here: Dark, glass Medium. -->
    <SolidColorBrush x:Key="BackdropBrush" Color="#FF0F0F10"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#E5FFFFFF"/>
    <SolidColorBrush x:Key="FocusTextBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="CancelBrush" Color="#FFB3261E"/>
    <SolidColorBrush x:Key="MaterialStrokeBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="GlyphCircleBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="DimBrush" Color="#E60F0F10"/>
    <!-- The material: acrylic that blurs the artwork behind it. Opaque when Liquid Glass is off. -->
    <AcrylicBrush x:Key="MaterialBrush" TintColor="#1E1E1E" TintOpacity="0.55" TintLuminosityOpacity="0.7" FallbackColor="#E61E1E1E"/>
    <!-- Liquid Glass: a soft light across the top and a lit rim, stronger with each depth. -->
    <LinearGradientBrush x:Key="SheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.35"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.35"/>
        <GradientStop Color="#05FFFFFF" Offset="0.65"/>
        <GradientStop Color="#24FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- The specular light on a focused card. -->
    <LinearGradientBrush x:Key="SpecularBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.4"/>
        <GradientStop Color="#00FFFFFF" Offset="0.7"/>
    </LinearGradientBrush>
    <!-- The artwork stays clear in the top shelf and fades under the dock and the grid. -->
    <LinearGradientBrush x:Key="ShelfFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#000F0F10" Offset="0"/>
        <GradientStop Color="#1A0F0F10" Offset="0.45"/>
        <GradientStop Color="#B30F0F10" Offset="0.78"/>
        <GradientStop Color="#F20F0F10" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShelfTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8C0F0F10" Offset="0"/>
        <GradientStop Color="#000F0F10" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShelfSideBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B30F0F10" Offset="0"/>
        <GradientStop Color="#4D0F0F10" Offset="0.45"/>
        <GradientStop Color="#000F0F10" Offset="0.75"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientBrush" Center="0.5,0.9" GradientOrigin="0.5,0.9" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Color="#40343434" Offset="0"/>
        <GradientStop Color="#000F0F10" Offset="1"/>
    </RadialGradientBrush>

    <!-- Type: Inter stands in for SF Pro (not licensed for Windows), at the kit's sizes and weights. -->
    <FontFamily x:Key="AppFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
    <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="AppFont"/>
    <x:Double x:Key="FocusScale">1.05</x:Double>

    <!-- Built-in controls (text boxes, lists) in the same colours. -->
    <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush"/>
    <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush"/>
    <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="FocusTextBrush"/>
    <StaticResource x:Key="TextControlBackground" ResourceKey="ControlBrush"/>
    <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ControlBrush"/>
    <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="FocusBrush"/>
    <StaticResource x:Key="TextControlBorderBrush" ResourceKey="MaterialStrokeBrush"/>
    <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="MaterialStrokeBrush"/>
    <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="FocusBrush"/>
    <StaticResource x:Key="TextControlHeaderForeground" ResourceKey="TextSecondaryBrush"/>
    <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush"/>
    <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="TextSecondaryBrush"/>
    <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="ControlBrush"/>
    <StaticResource x:Key="ListViewItemForeground" ResourceKey="TextBrush"/>
    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="GlyphCircleBrush"/>
    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="GlyphCircleBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="TextBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorPointerOverBrush" ResourceKey="TextBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorPressedBrush" ResourceKey="TextBrush"/>

    <!-- A material panel (dock, menu, alert, toast): blur, sheen and rim; the corner comes from CornerRadius. -->
    <Style x:Key="GlassPanel" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{StaticResource MaterialBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border Background="{StaticResource SheenBrush}" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                        <!-- The content (a menu's options) may fill the panel to its rounded edge; the soft rim stays on top. -->
                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Border BorderBrush="{StaticResource RimBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one focus behaviour, for every control: the background turns into the white platter and only the text and icons
         grow a little; the shape never does, so it never spills out of its panel. With the mouse, hovering moves the focus,
         so it looks the same. -->
    <ControlTemplate x:Key="PlatterTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.16">
                            <VisualTransition.GeneratedEasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Content.Foreground" Value="{StaticResource FocusTextBrush}"/>
                        </VisualState.Setters>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Platter" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="{StaticResource FocusScale}" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="{StaticResource FocusScale}" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerFocused">
                        <VisualState.Setters>
                            <Setter Target="Content.Foreground" Value="{StaticResource FocusTextBrush}"/>
                        </VisualState.Setters>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Platter" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="{StaticResource FocusScale}" Duration="0"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="{StaticResource FocusScale}" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="Press"/>
                </Grid.RenderTransform>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <Border x:Name="Platter" Opacity="0" Background="{StaticResource FocusBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
                <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RenderTransformOrigin="0.5,0.5" AutomationProperties.AccessibilityView="Raw">
                    <ContentPresenter.RenderTransform>
                        <ScaleTransform x:Name="Scale"/>
                    </ContentPresenter.RenderTransform>
                </ContentPresenter>
            </Grid>
        </Grid>
    </ControlTemplate>

    <Style x:Key="PlatterBase" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PlatterTemplate}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Product screen button: 84 high, corner 12, Bold 31, on the material. -->
    <Style x:Key="TvButton" TargetType="Button" BasedOn="{StaticResource PlatterBase}">
        <Setter Property="Background" Value="{StaticResource MaterialBrush}"/>
        <Setter Property="Height" Value="84"/>
        <Setter Property="MinWidth" Value="260"/>
        <Setter Property="Padding" Value="40,0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontSize" Value="31"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Alert button: 66 high, corner 16, Medium 29, filled. -->
    <Style x:Key="TvAlertButton" TargetType="Button" BasedOn="{StaticResource PlatterBase}">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Height" Value="66"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="FontSize" Value="29"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Cancelling is the destructive/escape action; keep it unmistakably red. -->
    <Style x:Key="TvCancelButton" TargetType="Button" BasedOn="{StaticResource TvAlertButton}">
        <Setter Property="Background" Value="{StaticResource CancelBrush}"/>
    </Style>

    <!-- Secondary actions such as Skip stay quiet and grey. -->
    <Style x:Key="TvSecondaryAlertButton" TargetType="Button" BasedOn="{StaticResource TvAlertButton}">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- Round icon button on the material, 64. -->
    <Style x:Key="TvIconButton" TargetType="Button" BasedOn="{StaticResource PlatterBase}">
        <Setter Property="Background" Value="{StaticResource MaterialBrush}"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="32"/>
        <Setter Property="FontSize" Value="26"/>
    </Style>

    <!-- A button inside the app bar: round, 56, no fill of its own until focused, so the bar reads as one piece. -->
    <Style x:Key="TvAppBarButton" TargetType="Button" BasedOn="{StaticResource PlatterBase}">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="FontSize" Value="24"/>
    </Style>

    <!-- List rows keep their shape: the background turns into the platter and FocusZoom grows only the text and icons. -->
    <ControlTemplate x:Key="ListRowTemplate" TargetType="Button">
        <Grid x:Name="Row">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Row.Opacity" Value="0.4"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="1"/>
                            <Setter Target="RowContent.Foreground" Value="{StaticResource FocusTextBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerFocused">
                        <VisualState.Setters>
                            <Setter Target="Highlight.Opacity" Value="1"/>
                            <Setter Target="RowContent.Foreground" Value="{StaticResource FocusTextBrush}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="Highlight" Opacity="0" Background="{StaticResource FocusBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
            <Grid Margin="{TemplateBinding Padding}">
                <ContentPresenter x:Name="RowContent" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  AutomationProperties.AccessibilityView="Raw"/>
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- Sidebar and settings row: 72 high, corner 16, Medium 25, no fill until focused. -->
    <Style x:Key="TvListItem" TargetType="Button" BasedOn="{StaticResource PlatterBase}">
        <Setter Property="Template" Value="{StaticResource ListRowTemplate}"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Context menu option: edge to edge in the panel. The ones in the middle are rectangles; the first takes the panel's
         top corners and the last its bottom ones (set from code), so the platter fills the rounded ends exactly. -->
    <Style x:Key="TvMenuItem" TargetType="Button" BasedOn="{StaticResource TvListItem}">
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="Height" Value="70"/>
        <Setter Property="Padding" Value="22,0,30,0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- A game card: 250×150, corner 30. It grows and lifts on focus from code (tvOS focus engine). -->
    <ControlTemplate x:Key="CardTemplate" TargetType="Button">
        <Grid x:Name="Root">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"/>
                    <VisualState x:Name="Pressed"/>
                    <VisualState x:Name="Disabled">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FocusStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="0:0:0.2"/>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Unfocused"/>
                    <VisualState x:Name="Focused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Specular" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerFocused">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Specular" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <ContentPresenter Content="{TemplateBinding Content}" CornerRadius="{TemplateBinding CornerRadius}"
                              Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                              AutomationProperties.AccessibilityView="Raw"/>
            <Border x:Name="Specular" Opacity="0" Background="{StaticResource SpecularBrush}" CornerRadius="{TemplateBinding CornerRadius}"
                    IsHitTestVisible="False"/>
        </Grid>
    </ControlTemplate>

    <Style x:Key="TvCard" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource CardTemplate}"/>
        <Setter Property="Width" Value="250"/>
        <Setter Property="Height" Value="150"/>
        <Setter Property="CornerRadius" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="False"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    </Style>

    <!-- Text field: 66 high, corner 16, white when focused, like tvOS. -->
    <Style x:Key="TvTextField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="MinHeight" Value="66"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>

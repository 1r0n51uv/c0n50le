<Window x:Class="C0n50le.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:C0n50le.Ui">
    <Grid x:Name="Root" Background="{StaticResource BackdropBrush}" XYFocusKeyboardNavigation="Enabled">
        <Grid.Resources>
            <!-- A button hint: the pad's button in a circle, then what it does. -->
            <Style x:Key="HintKey" TargetType="Border">
                <Setter Property="MinWidth" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="ui:Corners.Size" Value="Small"/>
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="HintKeyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="HintLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>
            <Style x:Key="PillText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="LineHeight" Value="22"/>
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            </Style>
            <Style x:Key="PillIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource TonalBrush}"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="ui:Corners.Size" Value="Pill"/>
            </Style>
        </Grid.Resources>

        <!-- The selected game's picture, cross-fading, under the ambient light and the veils that keep text readable. -->
        <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource AmbientBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource ScrimLeftBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource ScrimBottomBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource ScrimTopBrush}" IsHitTestVisible="False" Height="260" VerticalAlignment="Top"/>
        <Rectangle x:Name="PageDim" Fill="{StaticResource DimBrush}" Opacity="0" IsHitTestVisible="False"/>

        <Viewbox x:Name="ScaleBox" Stretch="Uniform">
            <Grid x:Name="Stage" Width="1920" Height="1080">

                <!-- ───────── Home ───────── -->
                <Grid x:Name="HomePage" Padding="72,44,72,36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>

                    <!-- Top bar, as in Console Mode: the name on the left; on the right, on one line and without boxes,
                         settings and desktop as icons, the controller in use and the clock. -->
                    <Grid Height="56">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="5" Height="28" CornerRadius="2.5" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="c0n50le" FontSize="26" FontWeight="SemiBold" CharacterSpacing="120" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="TopBar" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SystemPill" Style="{StaticResource IconButton}" Click="OnSystemClick">
                                <FontIcon Glyph="&#xE713;" FontSize="24"/>
                            </Button>
                            <Button x:Name="DesktopPill" Style="{StaticResource IconButton}" Click="OnDesktopClick" Margin="-18,0,0,0">
                                <FontIcon Glyph="&#xE7F4;" FontSize="24"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Home.InputGlyph, Mode=OneWay}" FontSize="22" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{x:Bind Home.InputLabel, Mode=OneWay}" FontSize="18" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Home.Clock, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hero: the selected game, big. -->
                    <StackPanel x:Name="Hero" Grid.Row="2" MaxWidth="1040" HorizontalAlignment="Left" Spacing="14" Margin="0,0,0,28">
                        <Border Width="64" Height="5" CornerRadius="2.5" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{x:Bind Home.HeroTitle, Mode=OneWay}" FontSize="76" FontWeight="Bold" CharacterSpacing="-20"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="84"
                                   LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{x:Bind Home.HeroDetails, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Home.HeroDescription, Mode=OneWay}" FontSize="22" LineHeight="32" TextWrapping="Wrap"
                                   MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" Opacity="0.9"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Height="32" Margin="0,6,0,0" HorizontalAlignment="Left"
                                    Visibility="{x:Bind Home.IsRunning, Mode=OneWay}" x:Name="RunningBadge">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Home.HeroStatus, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- The row of cards. -->
                    <ScrollViewer x:Name="CardsScroll" Grid.Row="3" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False" Margin="-24,0,-72,0">
                        <StackPanel x:Name="Cards" Orientation="Horizontal" Spacing="24" Padding="24,28,72,28"/>
                    </ScrollViewer>

                    <!-- Controller hints, only in controller mode. -->
                    <StackPanel x:Name="HomeHints" Grid.Row="4" Orientation="Horizontal" Spacing="32" VerticalAlignment="Center"
                                Visibility="{x:Bind Home.IsControllerMode, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.ConfirmGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintPlay, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.OptionsGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintOptions, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.MenuGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintSystem, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.BackGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintDesktop, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ───────── System ───────── -->
                <Grid x:Name="SystemPage" Padding="72,44,72,36" Visibility="Collapsed" RowSpacing="36">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>
                    <Grid Height="56">
                        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <Button x:Name="SystemBack" Style="{StaticResource RoundButton}" Click="OnSystemBackClick">
                                <FontIcon Glyph="&#xE72B;" FontSize="22"/>
                            </Button>
                            <TextBlock x:Name="SystemTitle" FontSize="44" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Home.Clock, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="*" MaxWidth="1120"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                            <StackPanel x:Name="Categories" Spacing="6" Padding="8,8,8,8"/>
                        </ScrollViewer>
                        <ScrollViewer x:Name="RowsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                            <StackPanel x:Name="Rows" Spacing="12" Padding="8,8,20,24"/>
                        </ScrollViewer>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="32" VerticalAlignment="Center"
                                Visibility="{x:Bind Home.IsControllerMode, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.ConfirmGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintSelect, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.BackGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintBack, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource HintKey}"><TextBlock Text="LB · RB" Style="{StaticResource HintKeyText}"/></Border>
                            <TextBlock Text="{x:Bind Home.HintCategory, Mode=OneWay}" Style="{StaticResource HintLabel}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ───────── Picker: setting choices in the middle, or a card's options as a popup on the card ───────── -->
                <Grid x:Name="Picker" Visibility="Collapsed" Background="{StaticResource DimBrush}" TabFocusNavigation="Cycle" Tapped="OnPickerBackgroundTapped">
                    <Border x:Name="PickerPanel" Style="{StaticResource SurfacePanel}" Background="{StaticResource SurfaceRaisedBrush}" Width="760"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,30" Tapped="OnPickerPanelTapped">
                        <Grid x:Name="PickerGrid" RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="PickerHeader" Spacing="6">
                                <TextBlock x:Name="PickerTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="PickerSubtitle" FontSize="17" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" MaxHeight="640" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                                <StackPanel x:Name="PickerOptions" Spacing="10" Padding="6"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ───────── Tour ───────── -->
                <Grid x:Name="TourLayer" Visibility="Collapsed">
                    <Rectangle Fill="{StaticResource DimBrush}" Opacity="0.7"/>
                    <Canvas>
                        <Border x:Name="TourHighlight" BorderBrush="{StaticResource AccentBrush}" BorderThickness="4" ui:Corners.Size="Large"
                                IsHitTestVisible="False"/>
                    </Canvas>
                    <Border x:Name="TourCard" Style="{StaticResource SurfacePanel}" Width="680" Padding="36,32" Background="{StaticResource SurfaceRaisedBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="TourStep" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="TourTitle" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="TourBody" FontSize="20" LineHeight="30" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <Button x:Name="TourNext" Style="{StaticResource PrimaryButton}" Click="OnTourNextClick"/>
                                <Button x:Name="TourSkip" Style="{StaticResource PillButton}" Height="56" Click="OnTourSkipClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ───────── Notices ───────── -->
                <Border x:Name="Toast" Style="{StaticResource SurfacePanel}" Background="{StaticResource SurfaceRaisedBrush}" Padding="28,16"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110" MaxWidth="1200"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <FontIcon Glyph="&#xE946;" FontSize="20" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" FontSize="19" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>

        <!-- ───────── Intro ───────── -->
        <Grid x:Name="IntroLayer" Visibility="Collapsed" Background="{StaticResource BackdropBrush}">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="26">
                        <TextBlock x:Name="IntroWord" Text="c0n50le" FontSize="150" FontWeight="Bold" CharacterSpacing="60"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Opacity="0"/>
                        <Border x:Name="IntroBar" Height="8" Width="0" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center"/>
                        <TextBlock x:Name="IntroTagline" FontSize="24" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                   Opacity="0" CharacterSpacing="200"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>

<Window x:Class="C0n50le.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{StaticResource BackdropBrush}" XYFocusKeyboardNavigation="Enabled">
        <Grid.Resources>
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="23"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="HintKey" TargetType="Border">
                <Setter Property="MinWidth" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="CornerRadius" Value="19"/>
                <Setter Property="Background" Value="{StaticResource GlyphCircleBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="HintKeyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
        </Grid.Resources>

        <!-- The focused game's artwork fills the screen, clear in the top shelf and fading under the dock. -->
        <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top"/>
        <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top"/>
        <Rectangle Fill="{StaticResource AmbientBrush}" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShelfSide" Fill="{StaticResource ShelfSideBrush}" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShelfFade" Fill="{StaticResource ShelfFadeBrush}" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource ShelfTopBrush}" IsHitTestVisible="False" Height="320" VerticalAlignment="Top"/>
        <Rectangle x:Name="PageDim" Fill="{StaticResource DimBrush}" Opacity="0" IsHitTestVisible="False"/>

        <Viewbox x:Name="ScaleBox" Stretch="Uniform">
            <Grid x:Name="Stage" Width="1920" Height="1080">

                <!-- ───────── Home: the top shelf above, the dock of games at the bottom ───────── -->
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Top shelf: the focused game, like a tvOS product screen. -->
                    <Grid x:Name="TopShelf" Padding="90,0,90,44">
                        <StackPanel x:Name="Hero" VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="14" MaxWidth="1000">
                            <Grid MinHeight="96">
                                <Image x:Name="HeroLogo" MaxHeight="210" MaxWidth="660" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Stretch="Uniform"/>
                                <TextBlock x:Name="HeroTitleText" Text="{x:Bind Home.HeroTitle, Mode=OneWay}" FontSize="76" FontWeight="Bold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" LineHeight="88"
                                           LineStackingStrategy="BlockLineHeight" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource TextBrush}"/>
                            </Grid>
                            <!-- The game's facts as badges: source, age rating, genre, year, platform, developer, players. -->
                            <StackPanel x:Name="HeroBadges" Orientation="Horizontal" Spacing="12" Margin="0,4,0,4"/>
                            <TextBlock Text="{x:Bind Home.HeroDescription, Mode=OneWay}" Visibility="{x:Bind Home.HasHeroDescription, Mode=OneWay}" FontSize="29" FontWeight="Medium" LineHeight="36"
                                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="3" MaxWidth="900"
                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind Home.IsRunning, Mode=OneWay}">
                                <Ellipse Width="12" Height="12" Fill="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Bind Home.HeroStatus, Mode=OneWay}" FontSize="25" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Widgets on the right, under the app bar: weather, news, gallery. Filled from code. -->
                        <Grid x:Name="WidgetColumn" Width="460" HorizontalAlignment="Right" Margin="0,150,0,0" RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentControl x:Name="WeatherWidget" Style="{StaticResource GlassPanel}" CornerRadius="30" Padding="28,22"/>
                            <ContentControl x:Name="NewsWidget" Grid.Row="1" Style="{StaticResource GlassPanel}" CornerRadius="30" Padding="28,22"/>
                            <Grid x:Name="GalleryWidget" Grid.Row="2" CornerRadius="30" Height="260" VerticalAlignment="Top" Background="{StaticResource ControlBrush}">
                                <Border x:Name="GallerySkeleton" Background="{StaticResource GlyphCircleBrush}" Visibility="Collapsed"/>
                                <!-- The newest four screenshots and videos, as one piece: selecting it opens the viewer. -->
                                <Button x:Name="GalleryOpen" Style="{StaticResource TvCard}" Width="Auto" Height="Auto" CornerRadius="30"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" Background="Transparent" Click="OnGalleryOpen">
                                    <Grid x:Name="GalleryGrid" RowSpacing="6" ColumnSpacing="6">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="GalleryMessage" Style="{StaticResource Caption}" FontSize="21" TextWrapping="Wrap"
                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="28,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- Dock: every game, then Add and Settings, on a glass platter (corner 60) that scrolls sideways. -->
                    <ContentControl x:Name="Dock" Grid.Row="1" Style="{StaticResource GlassPanel}" CornerRadius="60" Height="230" Width="1820"
                                    HorizontalAlignment="Center" Margin="0,0,0,96">
                        <ScrollViewer x:Name="DockScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" IsTabStop="False"
                                      BringIntoViewOnFocusChange="False">
                            <StackPanel x:Name="DockRow" Orientation="Horizontal" Spacing="50" Padding="76,0,76,0" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </ContentControl>
                </Grid>

                <!-- Top right: one glass app bar. Closed it shows only icons and the time; with the pointer over it, or the
                     controller focus inside it, it opens smoothly: the input device's name on the left of the clock, the
                     screen in use on its right. -->
                <ContentControl x:Name="TopBar" Style="{StaticResource GlassPanel}" CornerRadius="36" Height="72"
                                Padding="8,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,90,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Home.InputGlyph, Mode=OneWay}" FontSize="24" Foreground="{StaticResource TextSecondaryBrush}"
                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <Grid x:Name="InputDetail" Width="0" Opacity="0" VerticalAlignment="Center">
                            <TextBlock x:Name="InputDetailText" Text="{x:Bind Home.InputLabel, Mode=OneWay}" FontSize="21" FontWeight="Medium"
                                       Margin="12,0,0,0" HorizontalAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Home.Clock, Mode=OneWay}" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" Margin="18,0,18,0"/>
                        <Grid x:Name="DisplayDetail" Width="0" Opacity="0" VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayDetailText" Text="{x:Bind Home.DisplayLabel, Mode=OneWay}" FontSize="21" FontWeight="Medium"
                                       Margin="0,0,12,0" HorizontalAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                        <FontIcon Glyph="&#xE7F4;" FontSize="22" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"
                                  VerticalAlignment="Center"/>
                        <Button x:Name="SystemPill" Style="{StaticResource TvAppBarButton}" Click="OnSystemClick">
                            <FontIcon Glyph="&#xE713;" FontSize="24"/>
                        </Button>
                        <Button x:Name="DesktopPill" Style="{StaticResource TvAppBarButton}" Click="OnDesktopClick">
                            <FontIcon Glyph="&#xE73F;" FontSize="22"/>
                        </Button>
                    </StackPanel>
                </ContentControl>


                <!-- Controller hints, only in controller mode. -->
                <StackPanel x:Name="HomeHints" Orientation="Horizontal" Spacing="30" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="90,0,0,40" Visibility="{x:Bind Home.IsControllerMode, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.ConfirmGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                        <TextBlock Text="{x:Bind Home.HintPlay, Mode=OneWay}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.OptionsGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                        <TextBlock Text="{x:Bind Home.HintOptions, Mode=OneWay}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.MenuGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                        <TextBlock Text="{x:Bind Home.HintSystem, Mode=OneWay}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource HintKey}"><TextBlock Text="{x:Bind Home.BackGlyph, Mode=OneWay}" Style="{StaticResource HintKeyText}"/></Border>
                        <TextBlock Text="{x:Bind Home.HintDesktop, Mode=OneWay}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ───────── Settings: sidebar and rows, like tvOS Settings ───────── -->
                <Grid x:Name="SystemPage" Visibility="Collapsed" Padding="90,60,90,40" ColumnSpacing="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <Button x:Name="SystemBack" Style="{StaticResource TvIconButton}" Click="OnSystemBackClick"
                                    AllowFocusOnInteraction="False" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72B;" FontSize="24"/>
                            </Button>
                            <TextBlock x:Name="SystemTitle" FontSize="58" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                            <StackPanel x:Name="Categories" Spacing="6" Padding="4,8,24,8"/>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CategoryTitle" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="20,10,0,0" Height="56"/>
                        <ScrollViewer x:Name="RowsScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      BringIntoViewOnFocusChange="False" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                            <StackPanel x:Name="Rows" Spacing="4" Padding="8,8,24,24"/>
                        </ScrollViewer>
                        <TextBlock x:Name="RowFooter" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxLines="3"
                                   Margin="28,0,40,0" MinHeight="60"/>
                    </Grid>
                </Grid>

                <!-- ───────── A game's detail page: its title first, then card picture, backgrounds and description ───────── -->
                <Grid x:Name="DetailsPage" Visibility="Collapsed" Padding="90,60,90,40" ColumnSpacing="70">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="28">
                        <StackPanel Orientation="Horizontal" Spacing="22">
                            <Button x:Name="DetailsBack" Style="{StaticResource TvIconButton}" Click="OnDetailsBackClick"
                                    AllowFocusOnInteraction="False" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72B;" FontSize="24"/>
                            </Button>
                            <TextBlock x:Name="DetailsHeading" FontSize="44" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="470"
                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                        <Viewbox Width="500" Height="300" HorizontalAlignment="Left">
                            <Grid x:Name="DetailsCard" Width="250" Height="150" CornerRadius="30" Background="{StaticResource ControlBrush}"/>
                        </Viewbox>
                        <StackPanel x:Name="DetailsInfo" Spacing="10" MaxWidth="520" HorizontalAlignment="Left"/>
                        <StackPanel x:Name="DetailsBackgrounds" Orientation="Horizontal" Spacing="12"/>
                    </StackPanel>
                    <Grid Grid.Column="1" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DetailsSubtitle" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="20,10,0,0" Height="56"/>
                        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      BringIntoViewOnFocusChange="False" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                            <StackPanel x:Name="DetailsRows" Spacing="4" Padding="8,8,24,24"/>
                        </ScrollViewer>
                        <TextBlock x:Name="DetailsFooter" Grid.Row="2" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxLines="3"
                                   Margin="28,0,40,0" MinHeight="60"/>
                    </Grid>
                </Grid>

                <!-- ───────── Gallery viewer: one picture large, the previous and next ones with ←/→ or the buttons ───────── -->
                <Grid x:Name="GalleryViewer" Visibility="Collapsed" Background="#F2000000" Tapped="OnGalleryViewerTapped">
                    <Image x:Name="GalleryViewerImage" Stretch="Uniform" Margin="190,90,190,150"/>
                    <MediaPlayerElement x:Name="GalleryViewerVideo" Margin="190,90,190,150" AreTransportControlsEnabled="True"
                                        AutoPlay="True" Visibility="Collapsed"/>
                    <Button x:Name="GalleryViewerClose" Style="{StaticResource TvIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,48,70,0" Click="OnGalleryClose">
                        <FontIcon Glyph="&#xE711;" FontSize="24"/>
                    </Button>
                    <Button x:Name="GalleryViewerPrevious" Style="{StaticResource TvIconButton}" Width="84" Height="84" CornerRadius="42"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="70,0,0,0" Click="OnGalleryPrevious">
                        <FontIcon Glyph="&#xE76B;" FontSize="30"/>
                    </Button>
                    <Button x:Name="GalleryViewerNext" Style="{StaticResource TvIconButton}" Width="84" Height="84" CornerRadius="42"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" Click="OnGalleryNext">
                        <FontIcon Glyph="&#xE76C;" FontSize="30"/>
                    </Button>
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,56" Spacing="6">
                        <TextBlock x:Name="GalleryViewerName" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Foreground="White"
                                   TextTrimming="CharacterEllipsis" MaxWidth="1200"/>
                        <TextBlock x:Name="GalleryViewerCount" FontSize="20" TextAlignment="Center" Foreground="#B3FFFFFF"/>
                    </StackPanel>
                </Grid>

                <!-- ───────── Context menu (a card's options, a setting's choices) ───────── -->
                <Grid x:Name="MenuLayer" Visibility="Collapsed" Background="Transparent" Tapped="OnMenuBackgroundTapped">
                    <Canvas>
                    <ContentControl x:Name="MenuPanel" Style="{StaticResource GlassPopup}" CornerRadius="30" Width="460"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Tapped="OnMenuPanelTapped">
                        <ScrollViewer MaxHeight="760" Background="Transparent" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
                            <StackPanel x:Name="MenuItems" Background="Transparent"/>
                        </ScrollViewer>
                    </ContentControl>
                    </Canvas>
                </Grid>

                <!-- ───────── Alert ───────── -->
                <Grid x:Name="AlertLayer" Visibility="Collapsed" Background="{StaticResource ScrimBrush}">
                    <ContentControl x:Name="AlertPanel" Style="{StaticResource GlassPopup}" CornerRadius="48" Width="560"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,40,32,32">
                        <StackPanel Spacing="24">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="AlertTitle" FontSize="31" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="AlertBody" FontSize="25" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap"
                                           LineHeight="32" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ContentPresenter x:Name="AlertContent"/>
                            <StackPanel x:Name="AlertButtons" Spacing="14"/>
                        </StackPanel>
                    </ContentControl>
                </Grid>

                <!-- ───────── Tour ───────── -->
                <Grid x:Name="TourLayer" Visibility="Collapsed">
                    <Rectangle Fill="{StaticResource ScrimBrush}"/>
                    <Canvas>
                        <Border x:Name="TourHighlight" BorderBrush="{StaticResource FocusBrush}" BorderThickness="4" CornerRadius="34"
                                IsHitTestVisible="False"/>
                    </Canvas>
                    <ContentControl x:Name="TourCard" Style="{StaticResource GlassPopup}" CornerRadius="48" Width="620" Padding="40,36,40,32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <TextBlock x:Name="TourStep" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TourTitle" FontSize="31" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="TourBody" FontSize="25" FontWeight="Medium" LineHeight="32" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Spacing="14" Margin="0,8,0,0">
                                <Button x:Name="TourNext" Style="{StaticResource TvConfirmButton}" Click="OnTourNextClick"/>
                                <Button x:Name="TourSkip" Style="{StaticResource TvSecondaryAlertButton}" Click="OnTourSkipClick"/>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </Grid>

                <!-- ───────── Notice ───────── -->
                <ContentControl x:Name="Toast" Style="{StaticResource GlassPopup}" CornerRadius="30" Padding="32,20"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,110" MaxWidth="1200" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontSize="25" FontWeight="Medium" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                </ContentControl>
            </Grid>
        </Viewbox>

        <!-- ───────── Intro ───────── -->
        <Grid x:Name="IntroLayer" Visibility="Collapsed" Background="{StaticResource BackdropBrush}">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                        <TextBlock x:Name="IntroWord" Text="c0n50le" FontSize="150" FontWeight="Bold" CharacterSpacing="-20"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" Opacity="0"/>
                        <TextBlock x:Name="IntroTagline" FontSize="29" FontWeight="Medium" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Opacity="0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
